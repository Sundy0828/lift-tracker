{
  "name": "lift-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "dev": "pnpm --filter @lift/web run dev",
    "build": "pnpm --filter @lift/web run build",
    "preview": "pnpm --filter @lift/web run preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "lighthouse": "pnpm --filter @lift/web run lighthouse",
    "size": "pnpm --filter @lift/web run size",
    "test:rules": "pnpm --filter @lift/rules run test",
    "test:rules:ci": "firebase emulators:exec --project demo-lift-tracker --only firestore \"pnpm run test:rules\"",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @lift/web run e2e",
    "e2e:excluded": "pnpm --filter @lift/web run e2e:excluded",
    "e2e:ci": "firebase emulators:exec --project demo-lift-tracker --only auth,firestore \"pnpm run e2e\"",
    "emulators": "firebase emulators:start --project demo-lift-tracker",
    "deploy": "pnpm run build && firebase deploy --only hosting,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "icons": "pnpm --filter @lift/web run icons",
    "catalog:update": "pnpm --filter @lift/catalog run update",
    "seed": "node --import ./scripts/ts-resolve.mjs scripts/seed-history.ts",
    "seed:library": "node --import ./scripts/ts-resolve.mjs scripts/seed-library.ts",
    "prune-users": "node --import ./scripts/ts-resolve.mjs scripts/prune-users.ts",
    "verify-user": "node --import ./scripts/ts-resolve.mjs scripts/verify-user.ts",
    "negate-assisted": "node --import ./scripts/ts-resolve.mjs scripts/negate-assisted.ts",
    "set-name": "node --import ./scripts/ts-resolve.mjs scripts/set-name.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lift/domain": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase": "catalog:",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1",
    "vitest": "catalog:"
  }
}
