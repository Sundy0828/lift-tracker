{
  "name": "lift-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:ci": "firebase emulators:exec --project demo-lift-tracker --only firestore \"npm run test:rules\"",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ci": "firebase emulators:exec --project demo-lift-tracker --only auth,firestore \"npm run e2e\"",
    "emulators": "firebase emulators:start --project demo-lift-tracker",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "icons": "node scripts/generate-icons.ts",
    "catalog:update": "node --import ./scripts/ts-resolve.mjs scripts/build-catalog.ts",
    "seed": "node --import ./scripts/ts-resolve.mjs scripts/seed-history.ts",
    "prune-users": "node --import ./scripts/ts-resolve.mjs scripts/prune-users.ts",
    "verify-user": "node --import ./scripts/ts-resolve.mjs scripts/verify-user.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@tanstack/react-virtual": "^3.14.10",
    "dayjs": "^1.11.23",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
