# Copy to `.env.local` and fill in from the Firebase console:
#   Project settings (gear) > General > Your apps > SDK setup and configuration
#
# `.env.local` is git-ignored and overrides `.env` in every mode, so it covers
# `npm run dev`, `npm run build`, and the Playwright suite in one file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# false = talk to the real project. true = talk to the local emulator suite.
VITE_USE_FIREBASE_EMULATORS=false

# Store listings (MOBILE_PLAN, Phase 6). Leave empty until the app is listed:
# set, they point phone visitors at the store instead of the web install.
# VITE_IOS_APP_STORE_ID=
# VITE_ANDROID_PACKAGE=com.sundy0828.lifttracker
