{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Tests run under Vitest on Node, so they may read fixtures from disk.
    // App code deliberately gets no Node types (see tsconfig.app.json), and
    // that project stays the one enforcing it.
    "types": ["node", "vite/client", "vitest/globals"],
    "outDir": "./node_modules/.tmp/types/test",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  // Tests import app sources, so the project has to contain them. They are
  // compiled here as well as in the app project; the outDirs differ, so
  // nothing collides.
  "include": ["src", "scripts"],
  "exclude": ["src/sw.ts"]
}
