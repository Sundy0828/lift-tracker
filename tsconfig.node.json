{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // vite.config.ts imports src/app/manifest.ts by its real path.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "outDir": "./node_modules/.tmp/types/node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "eslint.config.js", "scripts", "src/domain", "src/app/manifest.ts"]
}
