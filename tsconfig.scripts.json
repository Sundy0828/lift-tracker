{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./node_modules/.tmp/types/scripts",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo"
  },
  // Admin scripts (seed, prune, verify) and the root Vitest config. Web and catalog tooling lives with
  // the package it serves.
  "include": ["scripts", "vitest.config.ts"],
  "references": [{ "path": "./packages/domain/tsconfig.lib.json" }]
}
