# Loaded in every mode, so `npm run dev`, `npm run build`, `npm run preview`
# and the Playwright suite all point at the local emulator suite by default.
#
# A project id prefixed with "demo-" makes the emulators run fully offline with
# no real credentials and no billing.
#
# For a real deploy, create `.env.production.local` (git-ignored) from
# `.env.example` — it overrides everything here, including the emulator flag.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lift-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-lift-tracker
VITE_FIREBASE_STORAGE_BUCKET=demo-lift-tracker.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATORS=true
