{
  "expo": {
    "name": "Lift",
    "slug": "lift-tracker",
    "scheme": "lifttracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sundy0828.lifttracker",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "associatedDomains": ["applinks:lift-tracker-e4a9c.web.app"]
    },
    "android": {
      "package": "com.sundy0828.lifttracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.USE_EXACT_ALARM"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lift-tracker-e4a9c.web.app",
              "pathPrefix": "/share/"
            },
            {
              "scheme": "https",
              "host": "lift-tracker-e4a9c.web.app",
              "pathPrefix": "/friend/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      "expo-audio",
      "expo-asset",
      ["expo-widgets", {}]
    ],
    "extra": {
      "webOrigin": "https://lift-tracker-e4a9c.web.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "35f12ec3-832a-4934-bc22-3145b4de1338"
      }
    },
    "owner": "sundy"
  }
}
