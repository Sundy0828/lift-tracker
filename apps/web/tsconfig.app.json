{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "outDir": "./node_modules/.tmp/types/app",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/sw.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
  "references": [
    { "path": "../../packages/domain/tsconfig.lib.json" },
    { "path": "../../packages/catalog/tsconfig.lib.json" },
    { "path": "../../packages/data/tsconfig.lib.json" },
    { "path": "../../packages/ui-tokens" }
  ]
}
