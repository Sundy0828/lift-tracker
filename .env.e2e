# Used only by `npm run e2e` (build --mode e2e). Vite loads `.env.[mode]` at a
# higher priority than `.env.local`, so the Playwright suite always targets the
# local emulator suite and can never create users or documents in a real
# Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lift-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-lift-tracker
VITE_FIREBASE_STORAGE_BUCKET=demo-lift-tracker.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATORS=true
