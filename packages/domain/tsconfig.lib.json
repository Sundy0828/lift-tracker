{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No DOM and no node types: the domain runs unchanged on web, on React
    // Native (Hermes) and in node scripts, so it may lean on none of them.
    "lib": ["ES2023"],
    "types": [],
    "outDir": "./node_modules/.tmp/types/lib",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
